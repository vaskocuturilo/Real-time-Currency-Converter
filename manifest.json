{
  "manifest_version": 3,
  "name": "Currency Converter Extension",
  "version": "3.0",
  "description": "A lightweight browser add‑on that instantly converts any currency value on a webpage to your preferred currency.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.ts"
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://www.youtube.com/*",
        "https://open.spotify.com/*"
      ],
      "js": [
        "loader.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content.js",
        "constants.js",
        "utils/*.js",
        "services/*.js",
        "ui/*.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}